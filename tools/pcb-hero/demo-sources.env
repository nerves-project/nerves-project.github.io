# What the hero's live demo (static/hero-pcb/vm/) is built from. Change a line here and the
# "hero demo" workflow rebuilds vm/ and opens a pull request with the result; locally,
# tools/pcb-hero/build_demo.sh does the same build.
#
# A plain list of NAME=value lines, read by sh.

# The emulator: TinyEMU compiled to WebAssembly.
TINYEMU_REPO=https://github.com/lawik/TinyEMU.git
TINYEMU_REF=27193090d03f8b95b4cd1ba2d2712cec1adae464

# The page side of the machine: NervesVM, the board, the terminal, and the scripts that turn a
# firmware into a disk image, a snapshot and delta updates.
JSNERVES_REPO=https://github.com/lawik/jsnerves.git
JSNERVES_REF=a6472c8d4c3fb0da2bdda38bde399abd31a2c9b9

# The firmware. The first version is the one in the disk image; the page offers updates to the
# others. Each is a tag (or commit) of the repository. The Nerves system is whatever that
# firmware's mix.exs asks for.
FIRMWARE_REPO=https://github.com/lawik/web-demo-nerves.git
FIRMWARE_REFS="v1.2.2 v1.2.3"
